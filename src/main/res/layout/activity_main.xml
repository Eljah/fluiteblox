<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="18dp"
    android:gravity="center_horizontal"
    android:background="@drawable/block_main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="#F7E06E"
        android:shadowColor="#2B1C0E"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:letterSpacing="0"
        android:textAllCaps="true"
        android:textSize="34sp" />

    <Button
        android:id="@+id/btn_tank_game"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/block_button_primary"
        android:fontFamily="monospace"
        android:text="PLAY TANKDROME"
        android:textAllCaps="true"
        android:textColor="#1E160B"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="BUILDER SETTINGS"
        android:textAllCaps="true"
        android:textColor="#CFE8C3"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_open_library"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/block_button_secondary"
        android:fontFamily="monospace"
        android:textAllCaps="true"
        android:textColor="#F2F4D8"
        android:textStyle="bold"
        android:text="@string/main_library" />

    <Button
        android:id="@+id/btn_capture_score"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/block_button_secondary"
        android:fontFamily="monospace"
        android:textAllCaps="true"
        android:textColor="#F2F4D8"
        android:textStyle="bold"
        android:text="@string/main_capture" />

    <Button
        android:id="@+id/btn_audio_settings"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/block_button_secondary"
        android:fontFamily="monospace"
        android:textAllCaps="true"
        android:textColor="#F2F4D8"
        android:textStyle="bold"
        android:text="@string/main_settings" />

    <Button
        android:id="@+id/btn_achievements"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/block_button_secondary"
        android:fontFamily="monospace"
        android:textAllCaps="true"
        android:textColor="#F2F4D8"
        android:textStyle="bold"
        android:text="@string/main_achievements" />
</LinearLayout>
