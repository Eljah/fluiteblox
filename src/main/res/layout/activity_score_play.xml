<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blox_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            style="@style/BloxScreen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_back_to_library"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/play_back"
                    style="@style/BloxButtonSecondary" />

                <TextView
                    android:id="@+id/text_piece_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    style="@style/BloxTitle" />
            </LinearLayout>


            <RadioGroup
                android:id="@+id/group_play_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_mode_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/play_mode_mic"
                    android:textColor="@color/blox_text"
                    android:fontFamily="monospace" />

                <RadioButton
                    android:id="@+id/radio_mode_midi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/play_mode_midi"
                    android:textColor="@color/blox_text"
                    android:fontFamily="monospace" />

                <RadioButton
                    android:id="@+id/radio_mode_tablature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/play_mode_tablature"
                    android:textColor="@color/blox_text"
                    android:fontFamily="monospace" />
            </RadioGroup>

            <tatar.eljah.recorder.PitchOverlayView
                android:id="@+id/pitch_overlay"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="12dp"
                style="@style/BloxGraphPanel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_restart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_restart"
                    style="@style/BloxButtonSecondary" />

                <CheckBox
                    android:id="@+id/check_simplified_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/play_simplified_mode"
                    android:textColor="@color/blox_text"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/play_waiting"
                style="@style/BloxBody" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/panorama_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <tatar.eljah.recorder.PitchOverlayView
            android:id="@+id/pitch_overlay_panorama"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/panorama_context_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btn_panorama_close"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="@string/action_close"
                        style="@style/BloxButtonSecondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panorama_nav_menu"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_panorama_up"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/play_panorama_up"
                        style="@style/BloxButtonSecondary" />

                    <Button
                        android:id="@+id/btn_panorama_down"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/play_panorama_down"
                        style="@style/BloxButtonSecondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_panorama_toggle_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/play_panorama_show_details"
                    style="@style/BloxButtonSecondary" />

                <Button
                    android:id="@+id/btn_panorama_back_to_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/play_panorama_back_to_nav"
                    android:visibility="gone"
                    style="@style/BloxButtonSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_panorama_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/BloxTitle" />

                <TextView
                    android:id="@+id/text_panorama_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/BloxBody" />

                <TextView
                    android:id="@+id/text_panorama_detail_extra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    style="@style/BloxMuted" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
