<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/BloxScreen">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/achievements_title"
        style="@style/BloxTitle" />

    <Spinner
        android:id="@+id/spinner_piece"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/block_input"
        android:padding="8dp" />

    <TextView
        android:id="@+id/text_achievement_overall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/achievements_overall_empty"
        style="@style/BloxPanel" />

    <TextView
        android:id="@+id/text_tank_achievement_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="@color/blox_text"
        android:background="@drawable/block_panel"
        android:padding="12dp" />

    <TextView
        android:id="@+id/text_achievement_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/achievements_empty"
        style="@style/BloxBody" />

    <tatar.eljah.recorder.AchievementGraphView
        android:id="@+id/achievement_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        style="@style/BloxGraphPanel" />

</LinearLayout>
